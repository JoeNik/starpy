# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME="Star Savings"

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/app/database.sqlite

# Server
HOST=0.0.0.0
PORT=38001

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8008

# File Upload
MAX_UPLOAD_SIZE=2097152
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Storage
STORAGE_PATH=./storage
AVATARS_PATH=storage/avatars
REWARDS_PATH=storage/rewards

API_URL=http://localhost:38000